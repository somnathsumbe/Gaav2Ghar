# Copy this file to .env.local for local development. Never commit real secrets.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB=gaav2ghar

# Required for /admin
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
# Generate a random secret, e.g. openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional official WhatsApp Cloud API status notifications (keep real values in Vercel env only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=gaav2ghar_order_status
WHATSAPP_TEMPLATE_LANGUAGE=en_US
